# ── AI Brain ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Recall.ai (meeting bot — replaces Joinly) ─────────────────────────
# Sign up at https://recall.ai — API key from dashboard
RECALL_API_KEY=your_recall_api_key_here
RECALL_REGION=us-east-1

# ── Joinly MCP server (run `docker run -p 8000:8000 ghcr.io/joinly-ai/joinly:latest`) ──
JOINLY_MCP_URL=http://localhost:8000/mcp/

# ── Joinly voice settings (passed to joinly server at runtime) ────────
# TTS provider: kokoro (default, local), elevenlabs, deepgram
JOINLY_TTS=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# STT provider: whisper (default, local), deepgram
JOINLY_STT=whisper
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── Slide presentation server ─────────────────────────────────────────
SLIDE_SERVER_HOST=0.0.0.0
SLIDE_SERVER_PORT=8080

# URL joinly's browser uses to reach the slide server for screen sharing.
# On Linux with Docker: use http://172.17.0.1:<port>/present  (Docker bridge host IP)
# On Mac with Docker:   use http://host.docker.internal:<port>/present
# Running natively (no Docker): use http://localhost:<port>/present
SLIDE_SHARE_URL=http://172.17.0.1:8080/present

# ── Presenter identity ────────────────────────────────────────────────
PRESENTER_NAME=Alex
